# Next.js uses server-side Axios to call the independently running stockio-service.
# Browser requests stay same-origin at /api/allocate; no CORS configuration is needed.
STOCKIO_API_URL=http://127.0.0.1:8080
# Set the same opt-in flag and explicit byte limit as the service to bound UI ingress too.
ALLOCATION_ADMISSION_ENABLED=false
# ALLOCATION_ADMISSION_MAX_REQUEST_BYTES=<positive byte limit>
